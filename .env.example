# ==============================================================================
# ERP INVENTORY SERVICE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server configuration
SERVER_PORT=8084

# Database configuration (PostgreSQL erp_inventory_db)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5436/erp_inventory_db
SPRING_DATASOURCE_USERNAME=inventory_user
SPRING_DATASOURCE_PASSWORD=inventory_secret

# Auth service JWKS URI
AUTH_JWKS_URI=http://localhost:8081/oauth2/jwks
