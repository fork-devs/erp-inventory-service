# ==============================================================================
# ERP INVENTORY SERVICE - ENVIRONMENT CONFIGURATION
# ==============================================================================
#
# Este fichero declara los NOMBRES de las variables, nunca sus valores. Ningun
# secreto (contrasenas, claves de servicio) se escribe aqui: se resuelve por
# variable de entorno o por el almacen de secretos.
# ==============================================================================

# Server configuration
SERVER_PORT=8084

# Database configuration (PostgreSQL erp_inventory_db)
#
# SPRING_DATASOURCE_USERNAME es el rol de EJECUCION: no es propietario de las
# tablas, porque el propietario elude su propia politica de Row-Level Security.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5436/erp_inventory_db
SPRING_DATASOURCE_USERNAME=erp_inventory_app
SPRING_DATASOURCE_PASSWORD=

# Rol PROPIETARIO: lo usan unicamente las migraciones de Flyway, que
# necesitan permisos de DDL. Lo crea la migracion V2.
SPRING_FLYWAY_USER=erp_inventory_owner
SPRING_FLYWAY_PASSWORD=

# Rol de EJECUCION de la aplicacion, que crea la migracion V2.
ERP_APP_DB_PASSWORD=

# Auth service JWKS URL
#
# El conjunto de claves se publica en /.well-known/jwks.json. Debe usar https
# fuera del perfil de desarrollo local.
JWKS_URL=https://auth.erp-automotriz.com/.well-known/jwks.json

# Stock
STOCK_LOCK_TIMEOUT=5s
STOCK_MAX_POR_TALLER=20
STOCK_INTERVALO=60s
